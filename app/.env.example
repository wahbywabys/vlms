# Postgres (same database as the API)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vtc_lms
# Signs the browser session cookie
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Shared with the API: the app mints short-lived bearer tokens with it
JWT_SECRET=dev-secret-change-me-at-least-32-characters
# The VTC_LMS API (api/)
API_URL=http://localhost:4000
