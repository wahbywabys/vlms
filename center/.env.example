# VTC_LMS centre server settings. The installer creates .env from this file,
# fills in the secrets and this computer's address. Edit, then run
# `docker compose up -d` to apply.

# ---- This centre --------------------------------------------------------
CENTER_NAME=VTC Training Centre
# The Wi-Fi name devices should join (shown on the /join page)
CENTER_WIFI=
# This server's address on the centre network. Reserve it in the router
# (DHCP reservation) so it never changes.
CENTER_IP=192.168.1.10
# Set to https://<CENTER_IP> to advertise the secure address on /join
CENTER_HTTPS_URL=
# Ports (change only if 80/443 are taken; then add HTTP_PORT_SUFFIX=:8080)
HTTP_PORT=80
HTTPS_PORT=443
HTTP_PORT_SUFFIX=

# true = load the demo centre and demo accounts (password demo1234) on first start
SEED_DEMO=false

# ---- Online sync (optional) ---------------------------------------------
# Your online hub (see hub/), the id you registered this centre with, and the
# key the hub returned. Leave empty to run fully offline.
CLOUD_HUB_URL=
CENTER_ID=
CENTER_KEY=
UPLINK_INTERVAL_S=60

# ---- Secrets (generated by the installer, keep private) -----------------
DB_PASSWORD=
SESSION_SECRET=
JWT_SECRET=

# ---- Images -------------------------------------------------------------
VTC_REGISTRY=ghcr.io/wahbywabys
VTC_VERSION=latest
