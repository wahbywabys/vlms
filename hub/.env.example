# VTC_LMS online hub settings. Copy to .env and fill in, or run ./install.sh
# which generates the keys for you.

# Database password (any long random string)
DB_PASSWORD=
# Admin key: registers training centres (keep private)
HUB_ADMIN_KEY=
# Export key: what your dashboard / quality system uses to read data
HUB_EXPORT_KEY=

# The public name of this hub, e.g. vtc-hub.example.org (for the optional https profile)
HUB_DOMAIN=

# Optional push to your systems
# Webhook URLs (comma-separated): POST {event, centerId, sentAt, data} on each upload
HUB_WEBHOOK_URLS=
# Signs each webhook: header X-VTC-Signature: sha256=<HMAC-SHA256 of the body>
HUB_WEBHOOK_SECRET=
# An xAPI LRS to copy every learning record to (e.g. https://lrs.example.org/xapi)
HUB_LRS_ENDPOINT=
HUB_LRS_USERNAME=
HUB_LRS_PASSWORD=

HUB_LOCAL_PORT=4100
VTC_REGISTRY=ghcr.io/wahbywabys
VTC_VERSION=latest
